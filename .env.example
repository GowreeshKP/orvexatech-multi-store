# ─────────────────────────────────────────────────────────────────────────────
# Orvexa Tech — Environment Variables Reference
# Copy this file, fill in real values, and set them in your Vercel dashboard.
# NEVER commit real credentials — .env* is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas (required on Vercel — localhost does not work) ──────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
# Replace <username>, <password>, <cluster> with your Atlas values.
MONGODB_MASTER_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orvexatech_master?retryWrites=true&w=majority

# Base URI for tenant databases — Atlas automatically creates DBs on first write.
# Leave the trailing slash / underscore — the tenant slug is appended at runtime.
MONGODB_TENANT_BASE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/orvexa_tenant_

# ── JWT Authentication ────────────────────────────────────────────────────────
# Use a long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Set to your Vercel deployment URL after first deploy.
CORS_ORIGIN=https://your-app.vercel.app

# ── One-time setup keys ───────────────────────────────────────────────────────
# Used by POST /api/auth/admin/bootstrap (creates the first super admin account)
# Used by POST /api/auth/seller/set-password (sets a merchant password)
# Change these to strong random strings before deploying.
ADMIN_BOOTSTRAP_KEY=replace_with_strong_random_key
ADMIN_SETUP_KEY=replace_with_another_strong_random_key

# ── Optional ─────────────────────────────────────────────────────────────────
# Vercel sets this automatically — do not set it manually.
# VERCEL=1

# Server port (local dev only — Vercel ignores this)
PORT=5000
